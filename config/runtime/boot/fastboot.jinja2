{# TODO: Add NFS boot support for fastboot devices.
   Fastboot bakes the kernel cmdline into boot.img via mkbootimg, so there is
   no way to dynamically inject nfsroot=<ip>:<path> at boot time the way
   u-boot/grub/depthcharge do.  Possible approaches:
   - LAVA dispatcher DHCP providing root-path (option 17)
   - A custom initrd that discovers the NFS export automatically
   - LAVA postprocessing gaining access to the NFS path before mkbootimg
   Until one of these is confirmed to work, fastboot platforms must be
   excluded from NFS jobs in the scheduler configuration.  #}
{# The profile packages artifacts; the device dictionary controls fastboot.
   Only profiles preserving a legacy initramfs fallback accept NFS-labelled jobs. #}
{% import 'fastboot/profiles/' + fastboot_image_profile|default('android') + '.jinja2' as profile with context %}
{% if boot_commands == 'nfs' and not profile.allow_nfs_fallback|default(false) %}
{{ kci_raise('fastboot requires an initramfs; NFS boot is not supported') }}
{% endif %}
{% if profile.host_boot_only|default(false) and fastboot_docker_image|default('') %}
{{ kci_raise('this fastboot profile requires host-side device pre_os_command execution') }}
{% endif %}
{% set needs_kselftest = test_method|default('') in ['kselftest', 'kselftest-platform-parameters'] %}
{% set ramdisk_url = node.artifacts.ramdisk|default('', true) %}
{% if not ramdisk_url %}
{% set ramdisk_url = ramdisk|default('', true) %}
{% endif %}
{% if not ramdisk_url %}
{% set configured_ramdiskroot = ramdiskroot|default('', true) %}
{% if configured_ramdiskroot %}
{% set ramdisk_url = configured_ramdiskroot + '/rootfs.cpio.gz' %}
{% endif %}
{% endif %}
{% if not ramdisk_url %}
{{ kci_raise('fastboot requires a ramdisk from node artifacts or a rootfs_ref') }}
{% endif %}
{% if not node.artifacts.kernel or not node.artifacts.dtb %}
{{ kci_raise('fastboot requires kernel and DTB artifact URLs') }}
{% endif %}
{% set kselftest_url = node.artifacts.kselftest_tar_xz|default(node.artifacts.kselftest_tar_gz, true) %}
{% if needs_kselftest and not kselftest_url %}
{{ kci_raise('kselftest requires a kselftest_tar_xz or kselftest_tar_gz artifact') }}
{% endif %}
- deploy:
    to: downloads
{% if profile.download_timeout %}
    timeout:
      minutes: {{ profile.download_timeout }}
    timeouts:
      download-retry:
        minutes: {{ profile.download_timeout }}
      http-download:
        minutes: {{ profile.download_timeout }}
{% endif %}
    images:
      image:
        url: {{ node.artifacts.kernel|tojson }}
      dtb:
        url: {{ node.artifacts.dtb|tojson }}
      ramdisk:
        url: {{ ramdisk_url|tojson }}
        compression: gz
        format: cpio.newc
        overlays:
          lava: true
{% if node.artifacts.modules %}
          modules:
            url: {{ node.artifacts.modules|tojson }}
            compression: xz
            format: tar
            path: /
{% endif %}
{% if needs_kselftest %}
          kselftest:
            compression: {{ 'xz' if node.artifacts.kselftest_tar_xz else 'gz' }}
            format: tar
            path: /opt/kselftests/mainline/
            url: {{ kselftest_url|tojson }}
{% endif %}
    postprocess:
      docker:
        image: {{ profile.postprocess_image|tojson }}
        steps:
        - |
{% set kernel = node.artifacts.kernel.split('?')[0].split('/')[-1] %}
{% set dtb = node.artifacts.dtb.split('?')[0].split('/')[-1] %}
{% set ramdisk_name = ramdisk_url.split('?')[0].split('/')[-1] %}
{{ profile.prepare(kernel, dtb, ramdisk_name)|indent(12, true) }}

- deploy:
    to: {{ profile.deploy_to }}
    images:
      {{ profile.image_label }}:
        url: {{ ('downloads://' + profile.image_name)|tojson }}
{% if fastboot_docker_image|default('') %}
    docker:
      image: {{ fastboot_docker_image|tojson }}
{% endif %}
    timeout:
      minutes: {{ profile.deploy_timeout }}

- boot:
    prompts:
    - '/ #'
    - '~ #'
    - 'root@[^:]+:~#'
    failure_retry: 3
    timeout:
      minutes: 10
    timeouts:
      bootloader-commands:
        minutes: 3
      auto-login-action:
        minutes: 2
    method: fastboot
{% if fastboot_docker_image|default('') %}
    docker:
      image: {{ fastboot_docker_image|tojson }}
{% endif %}
