# perf
{%- set pkgarch = ':' + sub_arch if sub_arch else '' %}
{%- if sub_arch %}
RUN dpkg --add-architecture {{ sub_arch }}
{%- endif %}
# clang and llvm are host tools for BPF skeletons; libraries target the build arch.
RUN apt-get update && apt-get install --no-install-recommends -y \
    clang \
    dpkg-dev \
    libc6-dev{{ pkgarch }} \
    libdw-dev{{ pkgarch }} \
    libelf-dev{{ pkgarch }} \
    libnuma-dev{{ pkgarch }} \
    libopencsd-dev{{ pkgarch }} \
    libssl-dev{{ pkgarch }} \
    libtraceevent-dev{{ pkgarch }} \
    libzstd-dev{{ pkgarch }} \
    llvm \
    pkg-config \
    zlib1g-dev{{ pkgarch }}

# Stage the package's matching runtime libraries for the perf archive.
RUN target_triplet="$(dpkg-architecture {% if sub_arch %}-a{{ sub_arch }} {% endif %}-qDEB_HOST_GNU_TYPE)" && \
    install -d "/opt/kernelci/perf-runtime/usr/lib/${target_triplet}" \
        /opt/kernelci/perf-runtime/usr/share/doc/opencsd && \
    cp -a /usr/lib/"${target_triplet}"/libopencsd*.so.* \
        "/opt/kernelci/perf-runtime/usr/lib/${target_triplet}/" && \
    cp /usr/share/doc/libopencsd1/copyright \
        /opt/kernelci/perf-runtime/usr/share/doc/opencsd/ && \
    dpkg-query -W libopencsd-dev{{ pkgarch }} libopencsd1{{ pkgarch }} \
        > /opt/kernelci/perf-runtime/usr/share/doc/opencsd/build-info
