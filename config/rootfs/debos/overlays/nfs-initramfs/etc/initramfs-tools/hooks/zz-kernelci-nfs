#!/bin/sh

PREREQ="klibc-utils"

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/lib/kernelci/mount.nfs /usr/sbin/mount.nfs

# copy_exec brings in the shared libraries but not the databases mount.nfs
# reads at run time.  nfs_get_netid() maps the transport to an RPC netid using
# getprotobynumber(), which reads /etc/protocols, and libtirpc's netconfig
# lookup, which reads /etc/netconfig.  When either is missing the lookup fails,
# nfs-utils records RPC_UNKNOWNPROTO and reports it as EPROTONOSUPPORT, and the
# root mount dies with "mount.nfs: Protocol not supported".  klibc's nfsmount
# carried its own RPC code and needed neither file.
#
# copy_file only warns and returns non-zero when the source is missing, and
# nothing here checks it, so a chroot without netbase used to produce an image
# that looked fine and then failed to mount its root.  Fail the build instead.
for db in /etc/netconfig /etc/protocols; do
	if [ ! -f "${db}" ]; then
		echo "zz-kernelci-nfs: ${db} is missing from the chroot" >&2
		exit 1
	fi
	copy_file config "${db}" "${db}"
done

# Keep klibc's helper next to mount.nfs instead of replacing it, and put the
# dispatching wrapper in its place.  klibc cannot do NFSv4, mount.nfs can; but
# mount.nfs negotiates through libtirpc and fails against hosts klibc mounts
# without complaint, which is what broke NFS root boots on part of the
# Collabora lab.  The wrapper sends v4 to mount.nfs and everything else to
# klibc first, so the image supports v4 without losing those hosts.
#
# klibc-utils installs nfsmount in /bin or /usr/bin depending on the merged-usr
# layout of the chroot; move whichever is there.  The klibc interpreter is
# already in the image for ipconfig and run-init, so keeping one more klibc
# binary costs nothing but its own size.
klibc_nfsmount=
for candidate in "${DESTDIR}/bin/nfsmount" "${DESTDIR}/usr/bin/nfsmount"; do
	if [ -f "${candidate}" ]; then
		klibc_nfsmount=${candidate}
		break
	fi
done

if [ -z "${klibc_nfsmount}" ]; then
	echo "zz-kernelci-nfs: klibc nfsmount is missing from the initramfs" >&2
	exit 1
fi

mv "${klibc_nfsmount}" "${DESTDIR}/bin/nfsmount.klibc"
rm -f "${DESTDIR}/bin/nfsmount" "${DESTDIR}/usr/bin/nfsmount"
copy_file script /usr/lib/kernelci/nfsmount /bin/nfsmount
