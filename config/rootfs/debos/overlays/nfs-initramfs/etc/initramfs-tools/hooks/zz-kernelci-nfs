#!/bin/sh

PREREQ="klibc-utils"

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/lib/kernelci/mount.nfs /usr/sbin/mount.nfs

# copy_exec brings in the shared libraries but not the databases mount.nfs
# reads at run time.  nfs_get_netid() maps the transport to an RPC netid using
# getprotobynumber(), which reads /etc/protocols, and libtirpc's netconfig
# lookup, which reads /etc/netconfig.  When either is missing the lookup fails,
# nfs-utils records RPC_UNKNOWNPROTO and reports it as EPROTONOSUPPORT, and the
# root mount dies with "mount.nfs: Protocol not supported".  klibc's nfsmount
# carried its own RPC code and needed neither file.
#
# copy_file only warns and returns non-zero when the source is missing, and
# nothing here checks it, so a chroot without netbase used to produce an image
# that looked fine and then failed to mount its root.  Fail the build instead.
for db in /etc/netconfig /etc/protocols; do
	if [ ! -f "${db}" ]; then
		echo "zz-kernelci-nfs: ${db} is missing from the chroot" >&2
		exit 1
	fi
	copy_file config "${db}" "${db}"
done

# Replace klibc's NFSv2/v3-only helper after its hook has installed it.
rm -f "${DESTDIR}/bin/nfsmount" "${DESTDIR}/usr/bin/nfsmount"
copy_file script /usr/lib/kernelci/nfsmount /bin/nfsmount
